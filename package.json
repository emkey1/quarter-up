{
  "name": "quarter-up",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Recreations of 1980s arcade games, built for the browser.",
  "workspaces": [
    "games/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "npm run dev -w games/bracer",
    "build": "node tools/build-arcade.mjs",
    "test": "npm run test --workspaces --if-present",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "lint": "npm run lint --workspaces --if-present"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "typescript": "^5.7.2",
    "vite": "^8.1.5",
    "vitest": "^4.1.10"
  }
}
